# Enquiry form -> email. Works without any setting: enquiries go to the address at the top of
# app/api/enquiry/route.js through FormSubmit (click the "Activate form" link it emails once).
# Optional: send through Resend instead (resend.com -> API Keys), and/or change the address.
# RESEND_API_KEY=
# ENQUIRY_FROM="Brands On Steroids <website@brandsonsteroids.com>"
# ENQUIRY_TO=

# Optional: also post each enquiry to a Telegram chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used to sign the catalogue video links. Any long random string.
# Not needed for local testing (one is generated automatically in .stream-secret).
# Set it when you deploy.
STREAM_SECRET=

# Videos from the Cloudflare R2 bucket. Fill in all four and the site streams from the bucket;
# leave them empty and it reads the folders on this computer instead.
#   R2_ACCOUNT_ID         Cloudflare dashboard -> R2 -> "Account ID" (right-hand side)
#   R2_BUCKET             the name of the bucket you uploaded to
#   R2_ACCESS_KEY_ID      R2 -> Manage API tokens -> Create API token (Object Read only)
#   R2_SECRET_ACCESS_KEY  shown once when that token is created
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. The "md" and "homepage" folders are found in the bucket by name. Only set these
# if yours are called something else (path inside the bucket, e.g. "videos/drama").
# R2_MD_FOLDER=
# R2_HOME_FOLDER=
