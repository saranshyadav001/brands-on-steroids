// Cloudflare Workers settings (the site is built for Workers by @opennextjs/cloudflare).
// Deploy with:  npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brands-on-steroids",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The bucket that holds the videos. The site reads it directly (no keys needed here).
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "bos-videos" }],
  "observability": { "enabled": true }
}
